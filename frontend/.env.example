# Optional API origin when the frontend and API are deployed separately
# (for example, https://api.example.com; /api/bookings is appended by the client).
# Leave empty to use the Vite development proxy and same-origin /api requests.
VITE_API_BASE_URL=

# Optional development proxy target (default: http://localhost:8080).
API_PROXY_TARGET=http://localhost:8080
